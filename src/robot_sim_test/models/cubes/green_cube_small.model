<?xml version="1.0"?>
<robot name="green_cube_small">
<!-- base -->
<link name="base_link">
<visual>
  <geometry>
    <box size="0.001 0.001 0.001" />
  </geometry>
  <origin rpy="0 0 0" xyz="0 0 0"/>
</visual>
</link>

  <!-- body (0.10m cube, class_id=3) -->
  <link name="body_link">
    <visual>
      <geometry>
        <box size="0.10 0.10 0.10"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.05"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.10 0.10 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.001667" ixy="0.0" ixz="0.0" iyy="0.001667" iyz="0.0" izz="0.001667"/>
    </inertial>
  </link>
  <joint name="base_to_body" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

<gazebo reference="body_link">
  <material>Gazebo/Green</material>
</gazebo>

<!-- Gazebo plugin for move -->
<gazebo>
  <plugin name="green_cube_small_controller" filename="libgazebo_ros_planar_move.so">
    <commandTopic>green_cube_small_vel</commandTopic>
    <odometryTopic>green_cube_small_odom</odometryTopic>
    <odometryFrame>green_cube_small_odom</odometryFrame>
    <odometryRate>0.0</odometryRate>
    <robotBaseFrame>base_link</robotBaseFrame>
    <broadcastTF>false</broadcastTF>
  </plugin>
</gazebo>

</robot>
